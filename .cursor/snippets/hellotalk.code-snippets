{
  "Angular v22 Standalone Signal Component (HelloTalk)": {
    "prefix": ["ng-signal-component", "ht-component"],
    "body": [
      "import { Component, inject, input, output, computed, signal } from '@angular/core';",
      "import { CommonModule } from '@angular/common';",
      "",
      "@Component({",
      "  selector: 'app-${1:feature-name}',",
      "  standalone: true,",
      "  imports: [CommonModule],",
      "  template: `",
      "    <div class=\"app-card app-padded space-y-3\">",
      "      <div class=\"flex items-center justify-between gap-2 border-b border-slate-100 pb-2\">",
      "        <h3 class=\"text-base font-black text-slate-900\">{{ title() }}</h3>",
      "        @if (isVip()) {",
      "          <span class=\"app-chip bg-amber-100 text-amber-800\">VIP Feature (8 UKP / \\$10 USD)</span>",
      "        }",
      "      </div>",
      "",
      "      <div class=\"ps-4 pe-4 pt-2 pb-2 text-sm text-slate-700\">",
      "        <ng-content></ng-content>",
      "      </div>",
      "    </div>",
      "  `,",
      "  styleUrls: ['./${1:feature-name}.component.scss']",
      "})",
      "export class ${2:FeatureName}Component {",
      "  readonly title = input<string>('${3:Feature Title}');",
      "  readonly isVip = input<boolean>(false);",
      "  readonly actionTriggered = output<void>();",
      "",
      "  readonly isActive = signal<boolean>(true);",
      "",
      "  onTrigger(): void {",
      "    this.actionTriggered.emit();",
      "  }",
      "}",
    ],
    "description": "Scaffold an Angular v22 standalone component using signals, logical RTL CSS properties (ps-, pe-), and British English/monetary formatting.",
  },
  "LingQ Universal Word Tokenisation (Intl.Segmenter)": {
    "prefix": ["intl-segmenter", "ht-tokens"],
    "body": [
      "const segmenter = new Intl.Segmenter('${1:en-GB}', { granularity: 'word' });",
      "const tokens = Array.from(segmenter.segment(${2:text})).map(segment => ({",
      "  token: segment.segment,",
      "  isWordLike: segment.isWordLike,",
      "  index: segment.index",
      "}));",
    ],
    "description": "Parse text into universal clickable word tokens using native Intl.Segmenter API (no regex or space-splitting).",
  },
  "NestJS PostGIS Spatial Matchmaking Query": {
    "prefix": ["nest-postgis", "ht-postgis"],
    "body": [
      "const query = `",
      "  SELECT id, display_name, native_language, target_languages, is_vip, coins_balance,",
      "         ST_Distance(",
      "           COALESCE(mock_location::geography, location::geography),",
      "           ST_SetSRID(ST_MakePoint($1, $2), 4326)::geography",
      "         ) as distance_metres",
      "  FROM users",
      "  WHERE ST_DWithin(",
      "          COALESCE(mock_location::geography, location::geography),",
      "          ST_SetSRID(ST_MakePoint($1, $2), 4326)::geography,",
      "          $3",
      "        )",
      "  ORDER BY distance_metres ASC",
      "  LIMIT 50;",
      "`;",
      "const partners = await this.supabase.rpc('match_users', { longitude: ${1:lon}, latitude: ${2:lat}, radius_metres: ${3:5000} });",
    ],
    "description": "Scaffold a PostGIS spatial query using ST_DWithin geography index with VIP location spoofing support and British English distance_metres.",
  },
  "Centrifugo v5 Connection Token Minting (NestJS)": {
    "prefix": ["nest-centrifugo", "ht-centrifugo"],
    "body": [
      "const payload = {",
      "  sub: ${1:userId},",
      "  exp: Math.floor(Date.now() / 1000) + (60 * 60 * 24), // 24 hours",
      "  info: {",
      "    display_name: ${2:user.display_name},",
      "    is_vip: ${3:user.is_vip}",
      "  }",
      "};",
      "const token = jwt.sign(payload, this.configService.get<string>('CENTRIFUGO_TOKEN_SECRET'));",
      "return { token };",
    ],
    "description": "Mint a Centrifugo v5 connection JWT containing user sub claims and VIP info.",
  },
}
