FROM docker.io/library/node:22.23.1-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates git jq python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN usermod --login worker --home /home/worker --move-home node \
    && groupmod --new-name worker node
USER worker
WORKDIR /workspace
ENV HOME=/home/worker

ENTRYPOINT []
