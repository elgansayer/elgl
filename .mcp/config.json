{
  "mcpServers": {
    "supabase-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:54322/postgres"
      ]
    },
    "workspace-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/elgan/dev/hellotalk/frontend",
        "/home/elgan/dev/hellotalk/backend",
        "/home/elgan/dev/hellotalk/supabase"
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "--repository",
        "/home/elgan/dev/hellotalk"
      ]
    },
    "flyonui": {
      "command": "npx",
      "args": ["-y", "flyonui-mcp"]
    }
  }
}
