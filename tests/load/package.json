{
  "name": "hellotalk-load-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Artillery load-testing suite for HelloTalk endpoints",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "test:trust-safety": "artillery run trust-and-safety.load.yml",
    "test:trust-safety:report": "artillery run --output ./reports/trust-safety-report.json trust-and-safety.load.yml && artillery report ./reports/trust-safety-report.json",
    "test:spam-detection": "artillery run spam-detection.load.yml",
    "test:spam-detection:report": "artillery run --output ./reports/spam-detection-report.json spam-detection.load.yml && artillery report ./reports/spam-detection-report.json",
    "test:srs-flashcards": "artillery run srs-flashcards.load.yml",
    "test:srs-flashcards:report": "artillery run --output ./reports/srs-flashcards-report.json srs-flashcards.load.yml && artillery report ./reports/srs-flashcards-report.json",
    "test:escrow-payments": "artillery run escrow-payments.load.yml",
    "test:escrow-payments:report": "artillery run --output ./reports/escrow-payments-report.json escrow-payments.load.yml && artillery report ./reports/escrow-payments-report.json",
    "test:economy": "artillery run economy.load.yml",
    "test:economy:report": "artillery run --output ./reports/economy-report.json economy.load.yml && artillery report ./reports/economy-report.json",
    "test:video-classrooms": "artillery run video-classrooms.load.yml",
    "test:video-classrooms:report": "artillery run --output ./reports/video-classrooms-report.json video-classrooms.load.yml && artillery report ./reports/video-classrooms-report.json",
    "test:discovery-map": "artillery run discovery-map.load.yml",
    "test:discovery-map:report": "artillery run --output ./reports/discovery-map-report.json discovery-map.load.yml && artillery report ./reports/discovery-map-report.json",
    "test:matchmaking": "artillery run matchmaking.load.yml",
    "test:matchmaking:report": "artillery run --output ./reports/matchmaking-report.json matchmaking.load.yml && artillery report ./reports/matchmaking-report.json",
    "test:discovery-validate": "node validate-discovery-load-tests.js",
    "test:reading-engine": "artillery run reading-engine.load.yml",
    "test:reading-engine:report": "artillery run --output ./reports/reading-engine-report.json reading-engine.load.yml && artillery report ./reports/reading-engine-report.json",
    "test:moments": "artillery run moments.load.yml",
    "test:moments:report": "artillery run --output ./reports/moments-report.json moments.load.yml && artillery report ./reports/moments-report.json",
    "test:all": "npm run test:trust-safety && npm run test:spam-detection && npm run test:srs-flashcards && npm run test:escrow-payments && npm run test:economy && npm run test:video-classrooms && npm run test:discovery-map && npm run test:matchmaking && npm run test:reading-engine && npm run test:moments"
  },
  "devDependencies": {
    "artillery": "^2.0.34"
  }
}
