# =============================================================================
# HelloTalk AI Swarm - Environment Configuration
# =============================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Server Configuration ---
PORT=3000
NODE_ENV=development

# --- Supabase (PostgreSQL & Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-jwt-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-token
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Centrifugo ---
CENTRIFUGO_URL=http://localhost:8001
CENTRIFUGO_API_KEY=secret-centrifugo-api-key-change-in-prod
CENTRIFUGO_SECRET=secret-centrifugo-token-key-change-in-prod

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_SECRET=secret-livekit-api-secret-change-in-prod

# --- Cloudflare R2 ---
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=hellotalk-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.yourdomain.com

# --- AI & NLP ---
DEEPL_API_KEY=your-deepl-api-key
AZURE_TRANSLATOR_KEY=your-azure-translator-key
AZURE_TRANSLATOR_REGION=global

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Apple App Store ---
APPLE_BUNDLE_ID=com.hellotalk.app
APPLE_SHARED_SECRET=your-app-specific-shared-secret
APPLE_ROOT_CA_CERT_1=your-apple-root-ca-g3-pem-contents
APPLE_ROOT_CA_CERT_2=your-apple-root-ca-g2-pem-contents
APPLE_VERIFICATION_URL=https://sandbox.itunes.apple.com/verifyReceipt

# --- Google Play ---
GOOGLE_PLAY_PACKAGE_NAME=com.hellotalk.app
GOOGLE_PLAY_ACCESS_TOKEN=your-google-play-service-account-oauth-token
GOOGLE_PUBSUB_AUDIENCE=https://api.hellotalk.app/monetisation/webhooks/google
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub-push@your-project.iam.gserviceaccount.com

# --- Internal ---
INTERNAL_API_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:4200

# =============================================================================
# AI Swarm Configuration
# =============================================================================

# --- Required ---
# DeepSeek API key (REQUIRED - the swarm cannot function without this).
DEEPSEEK_API_KEY=sk-your-deepseek-key

# --- Optional but recommended ---
# OpenAI API key (used by Aider/Copilot fallback, optional).
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_API_BASE=https://api.githubcopilot.com

# GitHub token (for PM loop issue sync, avoids rate limiting).
# GITHUB_TOKEN=ghp_your-github-token

# Telegram bot (for watchdog alerts).
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789

# --- Repo Identity (set if forking the project) ---
# SWARM_REPO_OWNER=elgansayer
# SWARM_REPO_NAME=hellotalk
# SWARM_GIT_REMOTE=origin
# SWARM_GIT_BRANCH=main
# SWARM_GIT_USER="AI Swarm"
# SWARM_GIT_EMAIL=swarm@hellotalk.local

# --- AI Tool Timeouts (seconds) ---
# AIDER_TIMEOUT=600            # absolute wall-clock cap for Aider
# AIDER_STUCK_TIMEOUT=300      # kill if no output/edits for this long
# ANTIGRAVITY_TIMEOUT=900
# ANTIGRAVITY_STUCK_TIMEOUT=300
# CLAUDE_TIMEOUT=600
# CLAUDE_STUCK_TIMEOUT=180

# --- Rate Limiter ---
# AI_RATE_COOLDOWN_SECONDS=15   # minimum gap between AI API calls
# AI_RATE_LOCK_TIMEOUT=300      # max wait to acquire the API lock
# AI_RATE_LOCK_STALE_SECONDS=1200  # steal lock if held this long (dead process)

# --- Loop Behaviour ---
# SWARM_MAX_RETRIES=3           # consecutive failures before marking STUCK
# SWARM_COOLDOWN=15             # seconds between pipeline cycles
# SWARM_MODEL_PAUSE=300         # seconds to wait when no model is callable

# --- Watchdog ---
# WATCHDOG_STALL_MINUTES=15     # minutes without a commit triggers alert
# WATCHDOG_ALERT_COOLDOWN=600   # seconds between repeat Telegram alerts
# WATCHDOG_RECOVERY_COOLDOWN=900 # seconds between recovery attempts

# --- PM Loop ---
# PM_SYNC_INTERVAL=3600         # seconds between GitHub issue syncs

# --- Sudo (for non-interactive apt installs) ---
# SWARM_SUDO_PW=your-sudo-password

# =============================================================================
# Swarmd.py Daemon Configuration (Python-based swarm)
# =============================================================================

# --- Swarmd.py Models & Providers ---
# Rotating model order for fallback chain. All must have their CLI + API keys.
# SWARM_MODEL_ORDER=claude,antigravity,copilot,deepseek

# --- Test Gating (swarmd.py) ---
# By default, swarmd.py blocks commits when tests fail and attempts AI fix.
# Set this to any value to commit despite test failures (like old behaviour).
# SWARM_RELAXED_TESTS=1

# --- QA Swarm ---
# Interval in seconds between adversarial E2E test runs (default: 7200 = 2h).
# QA_SYNC_INTERVAL=7200

# --- Coordination ---
# swarmd.py and the bash swarm cannot run simultaneously.
# Use `swarmctl daemon-start` or `swarmctl start` -- never both at once.
