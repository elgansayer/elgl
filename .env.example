# =============================================================================
# ELGL application and OpenHands Factory configuration
# =============================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# The NestJS API validates these application variables during startup. In
# NODE_ENV=production missing required credentials, known placeholders and
# malformed URLs are fatal. Real credentials belong in the deployment secret
# store, never in source control.
#
# How to read an entry:
#   KEY=value    Active entry. Supply a deployment-specific value before using
#                the file in production; example values fail startup checks.
#   KEY=         Optional. A blank value is accepted and leaves the feature off.
#   # KEY=value  Inactive entry. Optional overrides stay commented out to use
#                their default. Production-only secrets must be replaced before
#                they are uncommented.
#
# The application section mirrors backend/.env.example and adds the variables
# that Docker Compose itself interpolates.
# backend/src/config/env-example.contract.spec.ts fails the build when these
# files, the schema, the code and the compose files disagree. See
# docs/environment-configuration.md.
# =============================================================================

# --- Server Configuration ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
# Public origin of the web app. Device-transfer links are built from it, so it
# must point at the frontend, not at this API. Defaults to http://localhost:4200.
APP_URL=http://localhost:4200
INTERNAL_API_SECRET=change-me-in-production
LOG_LEVEL=info
# Enable only when the backend origin is restricted to Cloudflare so clients
# cannot forge CF-Connecting-IP. Otherwise network-abuse enforcement uses the
# direct Express remote address and ignores proxy-provided client IP headers.
TRUST_CLOUDFLARE_CONNECTING_IP=false
# Enables privacy-minimized ASN/hosting-provider abuse controls. This is ignored
# unless TRUST_CLOUDFLARE_CONNECTING_IP is also true. The origin must be
# Cloudflare-only and edge rules must overwrite (not preserve) X-ELGL-Client-ASN,
# X-ELGL-Client-Provider and X-ELGL-Client-Hosting before enabling this switch.
# X-ELGL-Client-ASN can be populated from Cloudflare ip.src.asnum. Provider name
# and hosting classification are optional and should come only from vetted edge
# intelligence. Never enable this on a directly reachable origin.
TRUST_CLOUDFLARE_NETWORK_METADATA=false

# --- Supabase (PostgreSQL & Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-jwt-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-token
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Centrifugo ---
# Base URL of the Centrifugo HTTP API (port 8000). Port 8001 is its internal
# Prometheus listener and must not be used here. The compose files override this
# for the api container with http://websocket:8000.
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=secret-centrifugo-api-key-change-in-prod
CENTRIFUGO_SECRET=secret-centrifugo-token-key-change-in-prod
CENTRIFUGO_CONNECTION_RATE_LIMIT=5
CENTRIFUGO_CONNECTION_RATE_WINDOW_SEC=60
# Optional override for the audio room health probe only. Leave unset to probe
# CENTRIFUGO_URL.
# CENTRIFUGO_API_URL=http://localhost:8000

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_SECRET=replace-with-at-least-32-character-livekit-secret
# docker-compose enables embedded TURN and fails closed unless the public TURN
# domain plus TLS certificate/key paths are configured. LiveKit issues
# short-lived TURN credentials to clients; no static TURN username/password is
# needed or stored here.
LIVEKIT_TURN_ENABLED=true
LIVEKIT_TURN_DOMAIN=turn.example.com
LIVEKIT_TURN_CERT_FILE=./secrets/livekit/turn.crt
LIVEKIT_TURN_KEY_FILE=./secrets/livekit/turn.key
LIVEKIT_TURN_TLS_PORT=443
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_RTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- Cloudflare R2 Worker gateway ---
CLOUDFLARE_R2_GATEWAY_URL=https://elgl-r2-gateway.example.workers.dev
CLOUDFLARE_R2_SIGNING_SECRET=replace-with-at-least-32-random-characters
CLOUDFLARE_R2_SERVICE_TOKEN=replace-with-a-different-32-character-secret
CLOUDFLARE_R2_PUBLIC_URL=https://media.yourdomain.com
CLOUDFLARE_R2_SOURCE_HOSTS=recordings.example.com
CLOUDFLARE_R2_UPLOAD_TTL_SECONDS=3600
CLOUDFLARE_R2_MAX_SINGLE_UPLOAD_BYTES=26214400
CLOUDFLARE_R2_MAX_MULTIPART_PART_BYTES=104857600
CLOUDFLARE_R2_SOURCE_FETCH_TIMEOUT_MS=30000

# --- Cloudflare Stream room recording ---
CLOUDFLARE_STREAM_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-least-privilege-stream-api-token
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=https://app.yourdomain.com
CLOUDFLARE_STREAM_POLL_INTERVAL_MS=5000
CLOUDFLARE_STREAM_RECORDING_TIMEOUT_MS=120000
CLOUDFLARE_STREAM_DELETE_RECORDING_AFTER_DAYS=1

# Optional general Cloudflare zone operations.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- AI & NLP ---
DEEPL_API_KEY=your-deepl-api-key
AZURE_TRANSLATOR_KEY=your-azure-translator-key
AZURE_TRANSLATOR_REGION=global
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_TRANSCRIPTION_TIMEOUT_MS=600000

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_DEVELOPER_MONTHLY_PRICE_ID=
STRIPE_DEVELOPER_YEARLY_PRICE_ID=

# --- Apple App Store ---
APPLE_BUNDLE_ID=com.elgl.app
APPLE_SHARED_SECRET=your-app-specific-shared-secret
APPLE_ROOT_CA_CERT_1=your-apple-root-ca-g3-pem-contents
APPLE_ROOT_CA_CERT_2=
APPLE_VERIFICATION_URL=https://sandbox.itunes.apple.com/verifyReceipt

# --- Google Play ---
GOOGLE_PLAY_PACKAGE_NAME=com.elgl.app
GOOGLE_PLAY_ACCESS_TOKEN=your-google-play-service-account-oauth-token
GOOGLE_PUBSUB_AUDIENCE=https://api.elgl.app/monetisation/webhooks/google
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub-push@your-project.iam.gserviceaccount.com

# --- Firebase (optional) ---
FIREBASE_SERVICE_ACCOUNT=

# --- Email (optional until mail delivery is enabled) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=ELGL
MAIL_FROM_ADDRESS=noreply@elgl.example.com

# --- Versioning ---
MINIMUM_SUPPORTED_APP_VERSION=1.0.0
GITHUB_REPO=

# --- Spam Detection ---
SPAM_DUPLICATE_THRESHOLD=3
SPAM_SIMILARITY_THRESHOLD=0.75

# --- Transfer ---
TRANSFER_SECRET=change-me-in-production

# --- Privacy & Legal ---
PRIVACY_EFFECTIVE_DATE=
TOS_EFFECTIVE_DATE=

# --- Datadog metrics (optional) ---
# The StatsD exporter is enabled only when DD_AGENT_HOST, DD_DOGSTATSD_PORT and
# DD_API_KEY are all set; otherwise the API logs a warning and skips metrics.
# docker-compose.prod.yml also uses DD_API_KEY and DD_ENV for the Datadog agent.
DD_AGENT_HOST=
DD_DOGSTATSD_PORT=
DD_API_KEY=
DD_ENV=

# --- LLM ---
# LLM_PROVIDER is one of: openai, anthropic, google, local.
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-provider-key
LLM_BASE_URL=
ANTHROPIC_VERSION=2023-06-01
# Optional overrides. Leave them commented out to use each consumer's default
# (set LLM_MODEL explicitly in production). Blank values are rejected because
# they would be sent to the provider as the model name or endpoint.
# LLM_MODEL=gpt-4o-mini
# LLM_API_URL=https://api.openai.com/v1/chat/completions

# --- Chat ---
MESSAGE_EDIT_WINDOW_MINUTES=5

# --- Docker Compose deployment ---
# Interpolated by docker-compose.yml, docker-compose.dev.yml and
# docker-compose.prod.yml. The NestJS API does not read these. The production
# compose file refuses to start without CENTRIFUGO_ALLOWED_ORIGINS and
# GRAFANA_ADMIN_PASSWORD. Values shown for the optional entries are the compose
# defaults.
# Space-separated browser origins allowed to open realtime connections. Never
# use * in production.
CENTRIFUGO_ALLOWED_ORIGINS=https://app.yourdomain.com
# Required by docker-compose.prod.yml. Supply a strong deployment-managed
# secret before uncommenting it. Keeping it inactive means a copied example
# cannot satisfy Compose's production credential check.
# GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-random-password
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB
# Datadog agent settings used by docker-compose.prod.yml (the agent also uses
# DD_API_KEY and DD_ENV above).
DD_SITE=datadoghq.com
DD_HOSTNAME=hellotalk-api
APP_VERSION=1.0.0

# =============================================================================
# OpenHands Factory Configuration
# =============================================================================

FACTORY_REPOSITORY=/var/lib/hellotalk-factory/repository
FACTORY_BASE_BRANCH=main
FACTORY_STATE_DIR=/var/lib/hellotalk-factory
FACTORY_LOG_DIR=/var/log/hellotalk-factory
FACTORY_PROFILE_STORE=/var/lib/hellotalk-factory/profiles
FACTORY_WORKTREE_DIR=/var/lib/hellotalk-factory/worktrees
FACTORY_RECOVERY_DIR=/var/lib/hellotalk-factory/recovery
FACTORY_PODMAN_PATH=/usr/bin/podman
FACTORY_TASK_IMAGE=localhost/hellotalk-factory-worker:current
FACTORY_ARCHITECTURE=openhands-agent-canvas-v1
FACTORY_AGENTS_CONFIG=/etc/hellotalk-factory/agents.json

# Subscription CLIs authenticate once in /var/lib/hellotalk-factory/home.
# Never place Claude, Codex, Google, or OpenCode subscription tokens here.
OPENHANDS_OPENAI_MODEL=gpt-5.6-sol
FACTORY_OPENAI_MAX_CONCURRENT_CONVERSATIONS=2

# Optional OpenHands SDK API compatibility route only. Direct OpenCode CLI
# subscription routing does not use these values.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=
OPENCODE_GO_PROFILE_NAME=opencode-go
FACTORY_OPENCODE_MAX_CONCURRENT_CONVERSATIONS=3

# API-backed Gemini routing is retired. Configure the Google subscription CLI
# in FACTORY_AGENTS_CONFIG and keep this false.
GEMINI_ENABLED=false

FACTORY_MONTHLY_SUBSCRIPTION_BUDGET_USD=30
FACTORY_MONTHLY_VARIABLE_BUDGET_USD=0
FACTORY_MONTHLY_TOTAL_BUDGET_USD=35
FACTORY_MAX_TASK_COST_USD=2
FACTORY_MAX_TASK_MINUTES=120
FACTORY_MAX_CONVERSATION_TURNS=100
FACTORY_MAX_CONSECUTIVE_FAILURES=3
FACTORY_MAX_PARALLEL_JOBS=3
# Admit one newly discovered GitHub issue per hour. This does not delay
# in-flight implementation, review, CI repair, or external PR handling.
FACTORY_NEW_ISSUE_INTERVAL_SECONDS=3600
FACTORY_NEW_ISSUES_PER_INTERVAL=1
FACTORY_REQUIRE_TRUSTED_INTAKE=true
FACTORY_TRUSTED_GITHUB_ACTORS=elgansayer,app/github-actions
FACTORY_REQUIRE_READY_LABEL=false
FACTORY_READY_LABEL=factory-ready
FACTORY_COOLDOWN_SECONDS=60
FACTORY_PROVIDER_COOLDOWN_SECONDS=300
FACTORY_PROVIDER_SLOT_WAIT_SECONDS=30
FACTORY_OAUTH_DEGRADED_HOURS=24
FACTORY_MINIMUM_FREE_DISK_GIB=5
FACTORY_MAX_NO_PR_HOURS=6
FACTORY_ARCHITECT_INTERVAL_HOURS=168
FACTORY_ARCHITECT_MAX_NEW_ISSUES=8

GITHUB_TOKEN=
GITHUB_REPOSITORY=elgansayer/elgl

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
