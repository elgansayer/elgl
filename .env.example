# =============================================================================
# HelloTalk application and OpenHands Factory configuration
# =============================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Server Configuration ---
PORT=3000
NODE_ENV=development

# --- Supabase (PostgreSQL & Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-jwt-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-token
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Centrifugo ---
CENTRIFUGO_URL=http://localhost:8001
CENTRIFUGO_API_KEY=secret-centrifugo-api-key-change-in-prod
CENTRIFUGO_SECRET=secret-centrifugo-token-key-change-in-prod

# WebSocket connection rate limiting (sliding-window, per-user, Redis-backed).
# CENTRIFUGO_CONNECTION_RATE_LIMIT controls the maximum number of new WebSocket
# connections allowed per identity during the configured window. Default: 5.
#CENTRIFUGO_CONNECTION_RATE_LIMIT=5

# CENTRIFUGO_CONNECTION_RATE_WINDOW_SEC defines the sliding window duration in
# seconds over which connection attempts are counted. Default: 60.
#CENTRIFUGO_CONNECTION_RATE_WINDOW_SEC=60

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_SECRET=secret-livekit-api-secret-change-in-prod

# LiveKit TURN relay for strict corporate NAT networks.
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_DOMAIN=turn.example.com
LIVEKIT_TURN_USERNAME=guest
LIVEKIT_TURN_PASSWORD=somepassword
LIVEKIT_TURN_CERT_FILE=
LIVEKIT_TURN_KEY_FILE=
LIVEKIT_TURN_TLS_PORT=5349
LIVEKIT_TURN_UDP_PORT=3478

# STUN servers used for ICE candidate gathering (comma-separated).
LIVEKIT_RTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- Cloudflare R2 Worker gateway ---
# The backend signs short-lived upload URLs for the Worker. Browsers and the
# Nest application never receive bucket access keys or use an AWS SDK.
CLOUDFLARE_R2_GATEWAY_URL=https://elgl-r2-gateway.example.workers.dev
CLOUDFLARE_R2_SIGNING_SECRET=replace-with-at-least-32-random-characters
CLOUDFLARE_R2_SERVICE_TOKEN=replace-with-a-different-32-character-secret
CLOUDFLARE_R2_PUBLIC_URL=https://media.yourdomain.com
CLOUDFLARE_R2_SOURCE_HOSTS=recordings.example.com
CLOUDFLARE_R2_UPLOAD_TTL_SECONDS=3600
CLOUDFLARE_R2_MAX_SINGLE_UPLOAD_BYTES=26214400
CLOUDFLARE_R2_MAX_MULTIPART_PART_BYTES=104857600
CLOUDFLARE_R2_SOURCE_FETCH_TIMEOUT_MS=30000

# --- Cloudflare Stream room recording ---
# LiveKit publishes RTMPS to a short-lived Cloudflare Stream live input. Stream
# records it automatically and produces an audio M4A for transcription.
CLOUDFLARE_STREAM_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-least-privilege-stream-api-token
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=https://app.yourdomain.com
CLOUDFLARE_STREAM_POLL_INTERVAL_MS=5000
CLOUDFLARE_STREAM_RECORDING_TIMEOUT_MS=120000
CLOUDFLARE_STREAM_DELETE_RECORDING_AFTER_DAYS=1

# --- AI & NLP ---
DEEPL_API_KEY=your-deepl-api-key
AZURE_TRANSLATOR_KEY=your-azure-translator-key
AZURE_TRANSLATOR_REGION=global
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_TRANSCRIPTION_TIMEOUT_MS=600000

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Apple App Store ---
APPLE_BUNDLE_ID=com.hellotalk.app
APPLE_SHARED_SECRET=your-app-specific-shared-secret
APPLE_ROOT_CA_CERT_1=your-apple-root-ca-g3-pem-contents
APPLE_ROOT_CA_CERT_2=your-apple-root-ca-g2-pem-contents
APPLE_VERIFICATION_URL=https://sandbox.itunes.apple.com/verifyReceipt

# --- Google Play ---
GOOGLE_PLAY_PACKAGE_NAME=com.hellotalk.app
GOOGLE_PLAY_ACCESS_TOKEN=your-google-play-service-account-oauth-token
GOOGLE_PUBSUB_AUDIENCE=https://api.hellotalk.app/monetisation/webhooks/google
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub-push@your-project.iam.gserviceaccount.com

# --- Email (password reset, notifications, etc.) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=HelloTalk
MAIL_FROM_ADDRESS=noreply@hellotalk.com

# --- Internal ---
INTERNAL_API_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:4200

# =============================================================================
# OpenHands Factory Configuration
# =============================================================================

FACTORY_REPOSITORY=/var/lib/hellotalk-factory/repository
FACTORY_BASE_BRANCH=main
FACTORY_STATE_DIR=/var/lib/hellotalk-factory
FACTORY_LOG_DIR=/var/log/hellotalk-factory
FACTORY_PROFILE_STORE=/var/lib/hellotalk-factory/profiles
FACTORY_WORKTREE_DIR=/var/lib/hellotalk-factory/worktrees
FACTORY_RECOVERY_DIR=/var/lib/hellotalk-factory/recovery
FACTORY_PODMAN_PATH=/usr/bin/podman
FACTORY_TASK_IMAGE=localhost/hellotalk-factory-worker:current
FACTORY_ARCHITECTURE=openhands-agent-canvas-v1
FACTORY_AGENTS_CONFIG=/etc/hellotalk-factory/agents.json

# Subscription CLIs authenticate once in /var/lib/hellotalk-factory/home.
# Never place Claude, Codex, Google, or OpenCode subscription tokens here.
OPENHANDS_OPENAI_MODEL=gpt-5.6-sol
FACTORY_OPENAI_MAX_CONCURRENT_CONVERSATIONS=2

# Optional OpenHands SDK API compatibility route only. Direct OpenCode CLI
# subscription routing does not use these values.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=
OPENCODE_GO_PROFILE_NAME=opencode-go
FACTORY_OPENCODE_MAX_CONCURRENT_CONVERSATIONS=3

# API-backed Gemini routing is retired. Configure the Google subscription CLI
# in FACTORY_AGENTS_CONFIG and keep this false.
GEMINI_ENABLED=false

FACTORY_MONTHLY_SUBSCRIPTION_BUDGET_USD=30
FACTORY_MONTHLY_VARIABLE_BUDGET_USD=0
FACTORY_MONTHLY_TOTAL_BUDGET_USD=35
FACTORY_MAX_TASK_COST_USD=2
FACTORY_MAX_TASK_MINUTES=120
FACTORY_MAX_CONVERSATION_TURNS=100
FACTORY_MAX_CONSECUTIVE_FAILURES=3
FACTORY_MAX_PARALLEL_JOBS=3
# Admit one newly discovered GitHub issue per hour. This does not delay
# in-flight implementation, review, CI repair, or external PR handling.
FACTORY_NEW_ISSUE_INTERVAL_SECONDS=3600
FACTORY_NEW_ISSUES_PER_INTERVAL=1
FACTORY_REQUIRE_TRUSTED_INTAKE=true
FACTORY_TRUSTED_GITHUB_ACTORS=elgansayer,app/github-actions
FACTORY_REQUIRE_READY_LABEL=false
FACTORY_READY_LABEL=factory-ready
FACTORY_COOLDOWN_SECONDS=60
FACTORY_PROVIDER_COOLDOWN_SECONDS=300
FACTORY_PROVIDER_SLOT_WAIT_SECONDS=30
FACTORY_OAUTH_DEGRADED_HOURS=24
FACTORY_MINIMUM_FREE_DISK_GIB=5
FACTORY_MAX_NO_PR_HOURS=6
FACTORY_ARCHITECT_INTERVAL_HOURS=168
FACTORY_ARCHITECT_MAX_NEW_ISSUES=8

GITHUB_TOKEN=
GITHUB_REPOSITORY=elgansayer/elgl

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
