# Ensure npm is available before running any Node‑based checks
if command -v npm >/dev/null 2>&1; then
  echo "✅ npm found."
else
  echo "⚠️  npm not found. Attempting to install Node.js and npm..."
  # Ensure install-node.sh is executable
  chmod +x "$(dirname -- "$0")/../install-node.sh"
  # Run install-node.sh with sudo if available
  if command -v sudo >/dev/null 2>&1; then
    sudo bash "$(dirname -- "$0")/../install-node.sh"
  else
    bash "$(dirname -- "$0")/../install-node.sh"
  fi
  if command -v npm >/dev/null 2>&1; then
    echo "✅ npm installed successfully."
  else
    echo "❌ npm installation failed. Skipping hooks."
    exit 1
  fi
fi

echo "🔍 Running Prettier on staged files..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.js' '*.ts' '*.json' '*.html' '*.css' '*.scss' '*.md' '*.yaml' '*.yml')

if [ -n "$STAGED_FILES" ]; then
  npx prettier --check $STAGED_FILES
  PRETTIER_EXIT=$?
  if [ $PRETTIER_EXIT -ne 0 ]; then
    echo "❌ Prettier check failed. Please run 'npx prettier --write .' and stage the changes."
    exit 1
  fi
else
  echo "ℹ️  No staged files that Prettier can handle. Skipping Prettier check."
fi

echo "🛡️  Running Engineering Constitution check on staged files..."

CONSTITUTION_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.html' '*.scss' '*.sql' '*.md' '*.json' '*.mdc')

if [ -n "$CONSTITUTION_FILES" ]; then
  npm run check:constitution -- $CONSTITUTION_FILES
else
  echo "ℹ️  No staged files for the constitution check. Skipping."
fi
