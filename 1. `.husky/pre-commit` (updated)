#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Ensure npm is available before running any Node‑based checks
if command -v npm >/dev/null 2>&1; then
  echo "✅ npm found."
else
  echo "⚠️  npm not found. Attempting to install Node.js and npm..."
  # Ensure install-node.sh is executable
  chmod +x "$(dirname -- "$0")/../install-node.sh"
  # Run install-node.sh with sudo if available
  if command -v sudo >/dev/null 2>&1; then
    sudo bash "$(dirname -- "$0")/../install-node.sh"
  else
    bash "$(dirname -- "$0")/../install-node.sh"
  fi
  if command -v npm >/dev/null 2>&1; then
    echo "✅ npm installed successfully."
  else
    echo "❌ npm installation failed. Skipping hooks."
    exit 1
  fi
fi

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
  echo "🔍 Running Prettier on staged files..."
  npx prettier --check $STAGED_FILES
  if [ $? -ne 0 ]; then
    echo "❌ Prettier check failed. Please run 'npx prettier --write .' to fix formatting."
    exit 1
  fi
else
  echo "ℹ️  No staged files. Skipping Prettier check."
fi

npm run check:constitution
