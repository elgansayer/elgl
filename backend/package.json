  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "sh -c 'eslint \"{src,apps,libs,test}/**/*.ts\" --fix'",
    "lint:check": "sh -c 'eslint \"{src,apps,libs,test}/**/*.ts\"'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "verify": "ts-node -r tsconfig-paths/register src/database/verify.ts",
    "tunnel": "ngrok http 3000"
  },
