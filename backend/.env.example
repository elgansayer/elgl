# Environment Configuration
# Copy this to .env and fill in values

# ─── Application ───
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
MIN_APP_VERSION=1.0.0
MINIMUM_SUPPORTED_APP_VERSION=1.0.0

# ─── Supabase (PostgreSQL + PostGIS + pg_trgm) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Centrifugo (Real-Time Messaging) ───
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=your-api-key
CENTRIFUGO_SECRET=your-secret

# ─── LiveKit (WebRTC Audio/Video) ───
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_SECRET=secret

# ─── Cloudflare R2 (Media Storage) ───
CLOUDFLARE_R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=hellotalk-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.hellotalk.example.com

# ─── DeepL (Translation API) ───
# Sign up at https://www.deepl.com/pro-api
DEEPL_API_KEY=your-deepl-api-key

# ─── Azure AI Services (Translator + Speech) ───
# Sign up at https://azure.microsoft.com/services/cognitive-services/
AZURE_TRANSLATOR_KEY=your-azure-translator-key
AZURE_TRANSLATOR_REGION=global
AZURE_SPEECH_REGION=westeurope

# ─── Stripe (Payments) ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# ─── Apple App Store (IAP + Server Notifications) ───
APPLE_BUNDLE_ID=com.hellotalk.app
APPLE_SHARED_SECRET=your-apple-shared-secret
APPLE_ROOT_CA_CERT_1=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
APPLE_ROOT_CA_CERT_2=
APPLE_VERIFICATION_URL=https://sandbox.itunes.apple.com/verifyReceipt

# ─── Google Play (IAP + RTDN Webhooks) ───
GOOGLE_PLAY_PACKAGE_NAME=com.hellotalk.app
GOOGLE_PLAY_ACCESS_TOKEN=ya29...
GOOGLE_PUBSUB_AUDIENCE=https://your-project.cloudfunctions.net/google-play-webhook
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ─── Firebase (Push Notifications + Google Play Auth) ───
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40your-project.iam.gserviceaccount.com"}

# ─── AI Swarm (autonomous coding agents) ───
# Required for all 3 swarm agents (Main, QA, PM).
DEEPSEEK_API_KEY=sk-...
# Required for watchdog Telegram alerts (see scripts/watchdog.sh).
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789
# Optional: sudo password for automatic sudo prompt answers (apt install, etc.).
SWARM_SUDO_PW=
# Optional: watchdog stall threshold in minutes (default 15).
WATCHDOG_STALL_MINUTES=15
# Optional: AI API rate limiter (seconds between calls, default 15).
AI_RATE_COOLDOWN_SECONDS=15
AI_RATE_LOCK_TIMEOUT=300
