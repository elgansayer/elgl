# =============================================================================
# ELGL API - Environment Configuration
# =============================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# This file documents every environment variable recognised by the NestJS
# application. Startup validation rejects malformed values in every environment.
# In NODE_ENV=production it also refuses to boot when required production
# credentials are missing or still contain known example/test placeholders.
# Optional integrations may remain blank only where shown below.
# =============================================================================

# -- Application --
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
APP_URL=http://localhost:3000
INTERNAL_API_SECRET=change-me-in-production
LOG_LEVEL=info
# Enable only when the backend origin is restricted to Cloudflare so clients
# cannot forge CF-Connecting-IP. Otherwise network-abuse enforcement uses the
# direct Express remote address and ignores proxy-provided client IP headers.
TRUST_CLOUDFLARE_CONNECTING_IP=false

# -- Supabase (PostgreSQL + PostGIS + pg_trgm) --
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# -- Redis --
REDIS_URL=redis://localhost:6379

# -- Centrifugo (Real-Time Messaging) --
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=your-api-key
CENTRIFUGO_SECRET=your-secret
CENTRIFUGO_CONNECTION_RATE_LIMIT=5
CENTRIFUGO_CONNECTION_RATE_WINDOW_SEC=60

# -- LiveKit (WebRTC Audio/Video) --
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_SECRET=secret
# The root docker-compose deployment enables LiveKit's embedded TURN service.
# It uses the same API key/secret pair as the API and generates short-lived TURN
# client credentials automatically; static TURN usernames/passwords are not used.
LIVEKIT_TURN_ENABLED=true
LIVEKIT_TURN_DOMAIN=turn.example.com
LIVEKIT_TURN_CERT_FILE=./secrets/livekit/turn.crt
LIVEKIT_TURN_KEY_FILE=./secrets/livekit/turn.key
LIVEKIT_TURN_TLS_PORT=443
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_RTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# -- Cloudflare R2 Worker gateway (application media storage) --
# Deploy workers/r2-gateway and set the Worker secrets with Wrangler:
#   npx wrangler secret put UPLOAD_SIGNING_SECRET
#   npx wrangler secret put SERVICE_TOKEN
# The matching values below are read only by the NestJS backend. The browser
# receives short-lived HMAC-signed upload URLs, never bucket credentials.
CLOUDFLARE_R2_GATEWAY_URL=https://elgl-r2-gateway.example.workers.dev
CLOUDFLARE_R2_SIGNING_SECRET=replace-with-at-least-32-random-characters
CLOUDFLARE_R2_SERVICE_TOKEN=replace-with-a-different-32-character-secret
CLOUDFLARE_R2_PUBLIC_URL=https://media.elgl.example.com
CLOUDFLARE_R2_SOURCE_HOSTS=recordings.elgl.example.com
CLOUDFLARE_R2_UPLOAD_TTL_SECONDS=3600
CLOUDFLARE_R2_MAX_SINGLE_UPLOAD_BYTES=26214400
CLOUDFLARE_R2_MAX_MULTIPART_PART_BYTES=104857600
CLOUDFLARE_R2_SOURCE_FETCH_TIMEOUT_MS=30000

# -- Cloudflare Stream (LiveKit room recording) --
# Use a least-privilege API token with Stream Read and Stream Write. LiveKit
# publishes RTMPS into a short-lived live input; Cloudflare records it and
# produces an audio-only M4A used by the transcription provider.
CLOUDFLARE_STREAM_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-least-privilege-stream-api-token
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=https://app.elgl.example.com
CLOUDFLARE_STREAM_POLL_INTERVAL_MS=5000
CLOUDFLARE_STREAM_RECORDING_TIMEOUT_MS=120000
CLOUDFLARE_STREAM_DELETE_RECORDING_AFTER_DAYS=1

# Optional general Cloudflare zone operations used by the existing cache/CDN
# integration. Keep this token separate from the Stream token.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# -- AI & NLP --
DEEPL_API_KEY=your-deepl-api-key
AZURE_TRANSLATOR_KEY=your-azure-translator-key
AZURE_TRANSLATOR_REGION=global
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_TRANSCRIPTION_TIMEOUT_MS=600000

# -- Stripe (Payments) --
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_DEVELOPER_MONTHLY_PRICE_ID=
STRIPE_DEVELOPER_YEARLY_PRICE_ID=

# -- Apple App Store (IAP + Server Notifications) --
APPLE_BUNDLE_ID=com.elgl.app
APPLE_SHARED_SECRET=your-apple-shared-secret
APPLE_ROOT_CA_CERT_1=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
APPLE_ROOT_CA_CERT_2=
APPLE_VERIFICATION_URL=https://sandbox.itunes.apple.com/verifyReceipt

# -- Google Play (IAP + RTDN Webhooks) --
GOOGLE_PLAY_PACKAGE_NAME=com.elgl.app
GOOGLE_PLAY_ACCESS_TOKEN=ya29...
GOOGLE_PUBSUB_AUDIENCE=https://your-project.cloudfunctions.net/google-play-webhook
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# -- Firebase (Push Notifications + Google Play Auth; optional) --
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40your-project.iam.gserviceaccount.com"}

# -- Email (optional until mail delivery is enabled) --
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=ELGL
MAIL_FROM_ADDRESS=noreply@elgl.example.com

# -- Versioning --
MINIMUM_SUPPORTED_APP_VERSION=1.0.0
GITHUB_REPO=

# -- Spam Detection --
SPAM_DUPLICATE_THRESHOLD=3
SPAM_SIMILARITY_THRESHOLD=0.75

# -- Transfer --
TRANSFER_SECRET=change-me-in-production

# -- Privacy & Legal --
PRIVACY_EFFECTIVE_DATE=
TOS_EFFECTIVE_DATE=

# -- LLM --
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-provider-key
LLM_BASE_URL=
LLM_MODEL=
ANTHROPIC_VERSION=2023-06-01

# -- Chat --
MESSAGE_EDIT_WINDOW_MINUTES=5
