# Logrotate config for HelloTalk AI Swarm logs.
# Install: sudo cp config/logrotate/ai-swarm /etc/logrotate.d/ai-swarm

/tmp/watchdog.log
/tmp/kickoff_reboot.log
/tmp/kickoff_recovery.log
/tmp/aider_*.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    maxsize 50M
}
