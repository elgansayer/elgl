# Repository-specific overrides. Secrets and provider routing are inherited from
# /etc/hellotalk-factory/factory.env by workout-agent-factory.service.
GITHUB_REPOSITORY=elgansayer/workout-agent
FACTORY_REPOSITORY_PROFILE=workout-agent
FACTORY_CONTROL_REPOSITORY=/var/lib/hellotalk-factory/repository
FACTORY_REPOSITORY=/var/lib/workout-agent-factory/repository
FACTORY_STATE_DIR=/var/lib/workout-agent-factory
FACTORY_LOG_DIR=/var/log/workout-agent-factory
FACTORY_PROFILE_STORE=/var/lib/workout-agent-factory/profiles
FACTORY_WORKTREE_DIR=/var/lib/workout-agent-factory/worktrees
FACTORY_RECOVERY_DIR=/var/lib/workout-agent-factory/recovery
FACTORY_MAX_PARALLEL_JOBS=1
FACTORY_REVIEW_LANE_MAX_CONCURRENT=1
FACTORY_NEW_ISSUE_INTERVAL_SECONDS=3600
FACTORY_NEW_ISSUES_PER_INTERVAL=1
FACTORY_MAX_NO_PR_HOURS=3
