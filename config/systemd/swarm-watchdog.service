[Unit]
Description=HelloTalk AI Swarm Watchdog
Documentation=https://github.com/elgansayer/hellotalk
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%u
WorkingDirectory=%h/hellotalk
ExecStart=%h/hellotalk/scripts/watchdog.sh
StandardOutput=append:/tmp/watchdog.log
StandardError=append:/tmp/watchdog.log
NoNewPrivileges=yes
