[Unit]
Description=HelloTalk Meta-Agent Watchdog
After=network.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/hellotalk
ExecStart=/home/dev/hellotalk/automation/.venv/bin/python /home/dev/hellotalk/automation/openhands_factory/meta_agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
