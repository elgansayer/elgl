[Unit]
Description=HelloTalk factory daemon self-healing watchdog
After=hellotalk-factory.service

[Service]
Type=oneshot
EnvironmentFile=/etc/hellotalk-factory/factory.env
EnvironmentFile=/etc/hellotalk-factory/runtime.env
Environment=HOME=/home/dev
ExecStart=/bin/bash /opt/hellotalk-factory/hellotalk-factory-watchdog.sh
UMask=0077
PrivateTmp=true
ProtectHome=false
BindPaths=/run/user
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/hellotalk-factory /var/log/hellotalk-factory /run/systemd
