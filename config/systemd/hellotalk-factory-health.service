[Unit]
Description=HelloTalk factory daemon self-healing watchdog
After=hellotalk-factory.service

[Service]
Type=oneshot
EnvironmentFile=/etc/hellotalk-factory/factory.env
Environment=HOME=/var/lib/hellotalk-factory/home
ExecStart=/opt/hellotalk-factory/hellotalk-factory-watchdog.sh
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/hellotalk-factory /var/log/hellotalk-factory /run/systemd
