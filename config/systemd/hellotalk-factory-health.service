[Unit]
Description=HelloTalk factory read-only health check

[Service]
Type=oneshot
User=hellotalk-factory
Group=hellotalk-factory
WorkingDirectory=/var/lib/hellotalk-factory/repository
EnvironmentFile=/etc/hellotalk-factory/factory.env
Environment=HOME=/var/lib/hellotalk-factory/home
ExecStart=/opt/hellotalk-factory/venv/bin/hellotalk-factory doctor
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
Delegate=yes
ProtectControlGroups=false
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/hellotalk-factory /var/log/hellotalk-factory
LimitNOFILE=4096
LimitNPROC=128
TasksMax=128
MemoryMax=512M
