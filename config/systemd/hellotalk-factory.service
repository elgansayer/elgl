[Unit]
Description=HelloTalk OpenHands Autonomous Development Factory
After=network-online.target user@988.service
Wants=network-online.target
Requires=user@988.service
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
User=hellotalk-factory
Group=hellotalk-factory
WorkingDirectory=/var/lib/hellotalk-factory/repository
EnvironmentFile=/etc/hellotalk-factory/factory.env
Environment=HOME=/var/lib/hellotalk-factory/home
# Rootless Podman needs a real systemd user session to delegate cgroups
# through (loginctl enable-linger hellotalk-factory creates user@<uid>.service).
# Without this, Podman falls back to a cgroupfs mode that races and fails
# under concurrent container starts. See docs/factory/README.md.
# 988 is the hellotalk-factory uid on the current host (check with
# `id -u hellotalk-factory`); update this and the unit name above if a
# fresh install assigns a different uid.
Environment=XDG_RUNTIME_DIR=/run/user/988
ExecStart=/opt/hellotalk-factory/venv/bin/hellotalk-factory daemon
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
KillSignal=SIGTERM
UMask=0077
PrivateTmp=true
# Rootless Podman/runc needs the host device namespace to mount /proc for
# nested worker containers. The worker itself remains capability- and
# network-constrained by secure_tools.py.
PrivateDevices=false
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectKernelLogs=true
# Rootless Podman receives only this service's delegated cgroup subtree. This is
# required for the per-worker CPU, memory and process limits below the parent cap.
Delegate=yes
ProtectControlGroups=false
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/hellotalk-factory /var/log/hellotalk-factory
LimitNOFILE=4096
LimitNPROC=1024
TasksMax=1024
MemoryHigh=6G
MemoryMax=7G

[Install]
WantedBy=multi-user.target
