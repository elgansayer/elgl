FACTORY_REPOSITORY=/var/lib/hellotalk-factory/repository
FACTORY_BASE_BRANCH=main
FACTORY_STATE_DIR=/var/lib/hellotalk-factory
FACTORY_LOG_DIR=/var/log/hellotalk-factory
FACTORY_PROFILE_STORE=/var/lib/hellotalk-factory/profiles
FACTORY_WORKTREE_DIR=/var/lib/hellotalk-factory/worktrees
FACTORY_RECOVERY_DIR=/var/lib/hellotalk-factory/recovery
FACTORY_PODMAN_PATH=/usr/bin/podman
FACTORY_TASK_IMAGE=localhost/hellotalk-factory-worker:current
# Static architecture identity. The daemon writes a separate per-process runtime
# generation UUID after acquiring factory.lock; do not preconfigure that UUID here.
FACTORY_ARCHITECTURE=openhands-agent-canvas-v1
FACTORY_AGENTS_CONFIG=/etc/hellotalk-factory/agents.json
OPENHANDS_OPENAI_MODEL=gpt-5.6-sol
FACTORY_OPENAI_MAX_CONCURRENT_CONVERSATIONS=2
# Optional emergency OpenHands API fallback. Direct OpenCode CLI subscription
# routing reads the service user's pre-authenticated local session instead.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=
OPENCODE_GO_PROFILE_NAME=opencode-go
FACTORY_OPENCODE_MAX_CONCURRENT_CONVERSATIONS=3
# Historical API-backed Gemini variables remain disabled. Configure the direct
# Google subscription CLI in FACTORY_AGENTS_CONFIG instead.
GEMINI_ENABLED=false
FACTORY_MONTHLY_SUBSCRIPTION_BUDGET_USD=30
# Non-zero so the emergency-only openhands API fallback can actually spend
# when all subscription CLIs are down or exhausted at once.
FACTORY_MONTHLY_VARIABLE_BUDGET_USD=5
FACTORY_MONTHLY_TOTAL_BUDGET_USD=40
FACTORY_MAX_TASK_COST_USD=2
FACTORY_MAX_TASK_MINUTES=120
FACTORY_MAX_CONVERSATION_TURNS=100
FACTORY_MAX_CONSECUTIVE_FAILURES=3
# Deliberately 3, not provider-count. 5 caused podman cgroup-start
# contention and provider rate-limit collisions (#3549) — do not raise.
FACTORY_MAX_PARALLEL_JOBS=3
FACTORY_NEW_ISSUE_INTERVAL_SECONDS=3600
FACTORY_NEW_ISSUES_PER_INTERVAL=1
# Bound AI-backed phase starts independently of issue intake. A normal issue can
# still fan out through implementation, security, review and repair, so one
# issue/hour alone is not an allowance budget. Conservative routing also permits
# at most one fallback provider and disables immediate same-provider retries.
FACTORY_AGENT_ROUTE_INTERVAL_SECONDS=3600
FACTORY_AGENT_ROUTES_PER_INTERVAL=6
# Keep review-lane jobs first when both PR and issue work are runnable.
FACTORY_REVIEW_LANE_FIRST=true
# Reserve one provider-slot token while a review worker is active to avoid review starvation.
FACTORY_REVIEW_RESERVE_PROVIDER_SLOT=true
# How many PR/review-lane jobs can run concurrently, out of FACTORY_MAX_PARALLEL_JOBS.
# 2 leaves at least 1 worker for issue backlog while clearing the PR queue faster.
FACTORY_REVIEW_LANE_MAX_CONCURRENT=2
# Minutes before a quarantined task (repeated identical failure) automatically
# returns to the runnable queue. This is a bounded cooldown, not a dead end:
# a fully autonomous deployment needs a task to retry on its own on a short
# horizon rather than sit inert for a day. Failure counters, the fingerprint,
# and last_error are preserved, so a genuinely broken task simply re-quarantines
# after its next few attempts instead of tight-looping.
FACTORY_QUARANTINE_RECOVERY_MINUTES=30
# Maximum stale ownership labels repaired per scheduler refresh. Keep this
# bounded so historical cleanup cannot monopolise the GitHub control plane.
FACTORY_LABEL_RECONCILIATION_BATCH_SIZE=25
FACTORY_REQUIRE_TRUSTED_INTAKE=true
FACTORY_TRUSTED_GITHUB_ACTORS=elgansayer,app/github-actions
# Remote pause, resume, status, and restart authority is deliberately narrower
# than automatic task-intake authority. Leave empty to disable remote controls.
FACTORY_CONTROL_GITHUB_ACTORS=elgansayer
FACTORY_REQUIRE_READY_LABEL=false
FACTORY_READY_LABEL=factory-ready
FACTORY_COOLDOWN_SECONDS=60
FACTORY_PROVIDER_COOLDOWN_SECONDS=300
FACTORY_PROVIDER_SLOT_WAIT_SECONDS=30
FACTORY_OAUTH_DEGRADED_HOURS=24
FACTORY_MINIMUM_FREE_DISK_GIB=5
# Crash-recovery worktree archives (recovery_dir) older than this are pruned
# on a periodic sweep. Left unbounded, they silently exhaust the disk reserve
# FACTORY_MINIMUM_FREE_DISK_GIB protects.
FACTORY_RECOVERY_RETENTION_HOURS=72
GITHUB_TOKEN=
GITHUB_REPOSITORY=elgansayer/elgl
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
