[Unit]
Description=Check for HelloTalk Factory updates every 30 minutes

[Timer]
# Pick up merged fixes promptly. The updater skips package refresh and restart
# when main and provider policy are unchanged, and drains active jobs otherwise.
OnCalendar=*-*-* *:00/30:00 UTC
Persistent=true
# Spread checks across hosts while bounding rollout delay.
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
