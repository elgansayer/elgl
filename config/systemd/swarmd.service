[Unit]
Description=HelloTalk AI Coding Supervisor (swarmd)
Documentation=https://github.com/elgansayer/hellotalk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%u
WorkingDirectory=%h/hellotalk
ExecStart=%h/hellotalk/swarmd.py
Restart=always
RestartSec=30
StandardOutput=append:%h/hellotalk/logs/swarmd_stdout.log
StandardError=append:%h/hellotalk/logs/swarmd_stderr.log

# Graceful shutdown: SIGTERM triggers state save and cleanup
KillSignal=SIGTERM
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/hellotalk /tmp

[Install]
WantedBy=multi-user.target
