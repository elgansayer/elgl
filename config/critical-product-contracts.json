{
  "adminApi": [
    {
      "name": "admin users list",
      "client": "admin-portal/src/app/admin-users.service.ts",
      "clientMarker": "/admin/v1/users",
      "server": "backend/src/admin/admin-v1.controller.ts",
      "serverMarkers": ["@Controller('admin/v1')", "@Get('users')", "@RequireAdminCapabilities('users.read')"]
    },
    {
      "name": "admin user detail",
      "client": "admin-portal/src/app/admin-users.service.ts",
      "clientMarker": "/admin/v1/users/${encodeURIComponent(userId)}",
      "server": "backend/src/admin/admin-v1.controller.ts",
      "serverMarkers": ["@Get('users/:id')", "@RequireAdminCapabilities('users.read')"]
    },
    {
      "name": "admin login history",
      "client": "admin-portal/src/app/admin-users.service.ts",
      "clientMarker": "/login-history",
      "server": "backend/src/admin/admin-v1.controller.ts",
      "serverMarkers": ["@Get('users/:id/login-history')", "@RequireAdminCapabilities('users.sessions.read')"]
    },
    {
      "name": "admin audit events",
      "client": "admin-portal/src/app/admin-audit.service.ts",
      "clientMarker": "/admin/v1/audit",
      "server": "backend/src/admin/admin-v1.controller.ts",
      "serverMarkers": ["@Get('audit')", "@RequireAdminCapabilities('audit.read')"]
    },
    {
      "name": "admin moderation reports",
      "client": "admin-portal/src/app/admin-moderation.service.ts",
      "clientMarker": "/admin/v1/moderation/reports",
      "server": "backend/src/admin/admin-v1.controller.ts",
      "serverMarkers": ["@Get('moderation/reports')", "@RequireAdminCapabilities('moderation.cases.read')"]
    },
    {
      "name": "admin role inventory",
      "client": "admin-portal/src/app/admin-roles.service.ts",
      "clientMarker": "/admin/v1/roles",
      "server": "backend/src/admin/admin-v1.controller.ts",
      "serverMarkers": ["@Get('roles')", "@RequireAdminCapabilities('roles.read')"]
    },
    {
      "name": "admin role assignments",
      "client": "admin-portal/src/app/admin-roles.service.ts",
      "clientMarker": "/admin/v1/roles/assignments",
      "server": "backend/src/admin/admin-roles-v1.controller.ts",
      "serverMarkers": ["@Controller('admin/v1/roles')", "@Get('assignments')", "@RequireAdminCapabilities('roles.read')"]
    },
    {
      "name": "admin system health",
      "client": "admin-portal/src/app/admin-system.service.ts",
      "clientMarker": "/admin/v1/system/health",
      "server": "backend/src/admin/admin-v1.controller.ts",
      "serverMarkers": ["@Get('system/health')", "@RequireAdminCapabilities('system.health.read')"]
    }
  ],
  "criticalJourneys": [
    {
      "name": "authentication",
      "anchors": ["backend/src/auth", "frontend/src/app"]
    },
    {
      "name": "profile and language preferences",
      "anchors": ["backend/src/users", "frontend/src/app"]
    },
    {
      "name": "audio-room authorization",
      "anchors": ["backend/src/audio-rooms", "frontend/src/app"]
    },
    {
      "name": "blocking and reporting",
      "anchors": ["backend/src/blocks", "backend/src/admin"]
    },
    {
      "name": "administrator authorization and audit",
      "anchors": ["backend/src/admin", "admin-portal/src/app"]
    }
  ]
}
