FACTORY_REPOSITORY=/var/lib/repo-factory/workout-agent/repository
FACTORY_BASE_BRANCH=main
FACTORY_STATE_DIR=/var/lib/repo-factory/workout-agent/state
FACTORY_LOG_DIR=/var/log/repo-factory/workout-agent
FACTORY_PROFILE_STORE=/var/lib/repo-factory/workout-agent/profiles
FACTORY_WORKTREE_DIR=/var/lib/repo-factory/workout-agent/worktrees
FACTORY_RECOVERY_DIR=/var/lib/repo-factory/workout-agent/recovery
FACTORY_REPOSITORY_PROFILE=workout-agent
FACTORY_PROMPT_DIR=/var/lib/repo-factory/control/automation/prompts
FACTORY_SYSTEM_PROMPT_PATH=/var/lib/repo-factory/control/automation/prompts/workout-agent-system.md
FACTORY_PROVIDER_CAPACITY_DIR=/var/lib/repo-factory/shared
FACTORY_AGENTS_CONFIG=/etc/repo-factory/agents.json
FACTORY_ARCHITECTURE=openhands-agent-canvas-v1
FACTORY_TASK_IMAGE=localhost/repo-factory-worker:current
FACTORY_MAX_PARALLEL_JOBS=1
FACTORY_NEW_ISSUE_INTERVAL_SECONDS=3600
FACTORY_NEW_ISSUES_PER_INTERVAL=1
FACTORY_REVIEW_LANE_MAX_CONCURRENT=1
FACTORY_ARCHITECT_INTERVAL_HOURS=876000
FACTORY_ARCHITECT_MAX_NEW_ISSUES=1
FACTORY_REQUIRE_TRUSTED_INTAKE=true
FACTORY_TRUSTED_GITHUB_ACTORS=elgansayer,app/github-actions
FACTORY_CONTROL_GITHUB_ACTORS=elgansayer
FACTORY_REQUIRE_READY_LABEL=true
FACTORY_READY_LABEL=factory-ready
GITHUB_REPOSITORY=elgansayer/workout-agent
