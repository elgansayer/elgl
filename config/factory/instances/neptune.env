# Preparatory configuration only. Do not enable a service from this file.
# Explicit canary activation follows accepted code, observed shared account limits,
# an isolated canonical clone/cache and the #33 bounded-job/recovery procedure.
FACTORY_NEPTUNE_ENABLED=false
FACTORY_REPOSITORY_PROFILE=neptune
FACTORY_REPOSITORY=/var/lib/repo-factory/neptune/repository
FACTORY_BASE_BRANCH=main
FACTORY_STATE_DIR=/var/lib/repo-factory/neptune/state
FACTORY_LOG_DIR=/var/log/repo-factory/neptune
FACTORY_PROFILE_STORE=/var/lib/repo-factory/neptune/profiles
FACTORY_WORKTREE_DIR=/var/lib/repo-factory/neptune/worktrees
FACTORY_RECOVERY_DIR=/var/lib/repo-factory/neptune/recovery
FACTORY_PROMPT_DIR=/var/lib/repo-factory/control/automation/neptune-prompts
FACTORY_SYSTEM_PROMPT_PATH=/var/lib/repo-factory/control/automation/neptune-prompts/system.md
FACTORY_PROVIDER_CAPACITY_DIR=/var/lib/repo-factory/shared
FACTORY_AGENTS_CONFIG=/etc/repo-factory/agents.json
FACTORY_ARCHITECTURE=openhands-agent-canvas-v1
FACTORY_TASK_IMAGE=localhost/repo-factory-worker:current
FACTORY_MAX_PARALLEL_JOBS=1
FACTORY_REQUIRE_TRUSTED_INTAKE=true
FACTORY_TRUSTED_GITHUB_ACTORS=elgansayer,app/github-actions
FACTORY_CONTROL_GITHUB_ACTORS=elgansayer
FACTORY_REQUIRE_READY_LABEL=true
FACTORY_READY_LABEL=factory-ready
FACTORY_REQUIRE_GREEN_MAIN_BETWEEN_MERGES=true
FACTORY_REVIEW_RESERVE_PROVIDER_SLOT=false
FACTORY_REVIEW_LANE_MAX_CONCURRENT=1
FACTORY_MAINTENANCE_ENABLED=false
FACTORY_MONTHLY_VARIABLE_BUDGET_USD=0
# Inherit the operator's existing funded/subscription caps and provider allowance
# settings; this instance must not create an additional account-wide allowance.
GITHUB_REPOSITORY=elgansayer/Neptune-Bomberman
