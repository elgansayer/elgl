.idea/

# Node & dependencies
# Factory task worktrees symlink node_modules in from a shared cache for
# build speed (git_workflow.py prepare_worktree). A trailing-slash pattern
# only matches real directories, not a symlink pointing at one, so the
# unslashed form is required too or the symlink shows up as untracked.
node_modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Build and test outputs
dist/
build/
out/
.angular/
.next/
.cache/
coverage/
test-results/
**/test-results/
**/playwright-report/
**/cypress/screenshots/
**/cypress/videos/

# Environment files & secrets
.env
.env.*
!.env.example

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

