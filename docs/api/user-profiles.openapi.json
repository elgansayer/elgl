{
  "openapi": "3.0.3",
  "info": {
    "title": "ELGL User Profiles API",
    "version": "1.0.0",
    "description": "Architecture contract for authenticated user-profile, privacy, social-graph, visitor, business-profile, and account-lifecycle endpoints exposed by UsersController. The live NestJS Swagger UI is served at /api/docs; this document is the reviewable profile-domain contract and must stay aligned with the controller."
  },
  "servers": [{ "url": "/api" }],
  "tags": [
    {
      "name": "User Profiles",
      "description": "Profile identity, learner metadata, privacy, social graph, profile media, visitors, business profile, notification preferences, and account lifecycle."
    }
  ],
  "security": [{ "bearer": [] }],
  "paths": {
    "/users/me": {
      "get": {
        "tags": ["User Profiles"],
        "summary": "Get the authenticated user's profile",
        "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "patch": {
        "tags": ["User Profiles"],
        "summary": "Update the authenticated user's profile",
        "description": "Requires a valid Supabase JWT and the existing TwoFactorGuard. VIP-only profile capabilities remain server-authoritative.",
        "x-requires-2fa": true,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "delete": {
        "tags": ["User Profiles"],
        "summary": "Schedule account deletion",
        "x-requires-2fa": true,
        "responses": { "200": { "description": "Deletion scheduled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeletionScheduled" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "429": { "$ref": "#/components/responses/TooManyRequests" } }
      }
    },
    "/users/me/permanent": {
      "delete": {
        "tags": ["User Profiles"],
        "summary": "Permanently delete the authenticated account",
        "description": "Destructive, non-recoverable account deletion. Requires TwoFactorGuard and is independently throttled.",
        "x-requires-2fa": true,
        "responses": { "200": { "$ref": "#/components/responses/MessageResponse" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "429": { "$ref": "#/components/responses/TooManyRequests" } }
      }
    },
    "/users/me/restore": {
      "post": {
        "tags": ["User Profiles"],
        "summary": "Cancel a scheduled account deletion",
        "x-requires-2fa": true,
        "responses": { "200": { "$ref": "#/components/responses/MessageResponse" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "429": { "$ref": "#/components/responses/TooManyRequests" } }
      }
    },
    "/users/me/export": {
      "get": {
        "tags": ["User Profiles"],
        "summary": "Export the authenticated user's data",
        "responses": { "200": { "description": "User-scoped data export", "headers": { "Cache-Control": { "schema": { "type": "string" }, "description": "Consumers should treat exports as private data and avoid shared caches." } }, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/users/me/stats": {
      "get": { "tags": ["User Profiles"], "summary": "Get profile learning/activity stats", "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/xp": {
      "get": { "tags": ["User Profiles"], "summary": "Get total XP", "responses": { "200": { "description": "Current total XP", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/XpResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/assess-proficiency": {
      "post": {
        "tags": ["User Profiles"],
        "summary": "Persist a proficiency level from an assessment score",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProficiencyAssessmentRequest" } } } },
        "responses": { "200": { "description": "Assigned proficiency level", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProficiencyAssessmentResponse" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/users/me/greeting": {
      "patch": { "tags": ["User Profiles"], "summary": "Update greeting message", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["greetingMessage"], "properties": { "greetingMessage": { "type": "string" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/away": {
      "patch": { "tags": ["User Profiles"], "summary": "Update away message", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["awayMessage"], "properties": { "awayMessage": { "type": "string" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/avatar/presigned-url": {
      "post": { "tags": ["User Profiles"], "summary": "Create an avatar upload URL", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MediaPresignRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/MediaPresignResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/cover-photo/presigned-url": {
      "post": { "tags": ["User Profiles"], "summary": "Create a cover-photo upload URL", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MediaPresignRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/MediaPresignResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/cover-photo": {
      "patch": { "tags": ["User Profiles"], "summary": "Persist the user's cover-photo URL", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["cover_photo_url"], "properties": { "cover_photo_url": { "type": "string", "format": "uri" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/visitors": {
      "get": { "tags": ["User Profiles"], "summary": "Get profile visitors subject to visitor privacy/VIP policy", "responses": { "200": { "description": "Profile visitors", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileVisitor" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/status/{statusId}/viewers": {
      "get": { "tags": ["User Profiles"], "summary": "Get viewers for one owned status", "parameters": [{ "$ref": "#/components/parameters/StatusId" }], "responses": { "200": { "description": "Status viewers", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileVisitor" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    },
    "/users/me/status-viewers": {
      "get": { "tags": ["User Profiles"], "summary": "Get viewers for the authenticated user's default status", "responses": { "200": { "description": "Status viewers", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileVisitor" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/hobbies": {
      "get": { "tags": ["User Profiles"], "summary": "List supported hobbies", "responses": { "200": { "description": "Hobby catalogue", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" } } } } } } }
    },
    "/users/interests": {
      "get": { "tags": ["User Profiles"], "summary": "List supported interests", "responses": { "200": { "description": "Interest catalogue", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" } } } } } } }
    },
    "/users/search": {
      "get": { "tags": ["User Profiles"], "summary": "Search user profiles", "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 10 } }], "responses": { "200": { "description": "Bounded profile search results", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileSearchResult" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/badges": {
      "get": { "tags": ["User Profiles"], "summary": "Get earned profile badges", "responses": { "200": { "description": "Badge list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Badge" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/{id}": {
      "get": { "tags": ["User Profiles"], "summary": "Get a profile subject to visibility policy", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/users/{id}/stats": {
      "get": { "tags": ["User Profiles"], "summary": "Get public profile stats", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/users/{id}/followers": {
      "get": { "tags": ["User Profiles"], "summary": "List followers", "parameters": [{ "$ref": "#/components/parameters/UserId" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Offset" }], "responses": { "200": { "$ref": "#/components/responses/ProfilePageResponse" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/{id}/following": {
      "get": { "tags": ["User Profiles"], "summary": "List followed profiles", "parameters": [{ "$ref": "#/components/parameters/UserId" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Offset" }], "responses": { "200": { "$ref": "#/components/responses/ProfilePageResponse" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/{id}/follow": {
      "post": { "tags": ["User Profiles"], "summary": "Follow a user", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "204": { "description": "Follow relationship created or already satisfied" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } } },
      "delete": { "tags": ["User Profiles"], "summary": "Unfollow a user", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "204": { "description": "Follow relationship removed or already absent" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/block/{id}": {
      "post": { "tags": ["User Profiles"], "summary": "Block a user", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "200": { "$ref": "#/components/responses/SuccessResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } },
      "delete": { "tags": ["User Profiles"], "summary": "Unblock a user", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "200": { "$ref": "#/components/responses/SuccessResponse" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/report": {
      "post": { "tags": ["User Profiles"], "summary": "Report a user", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportUserRequest" } } } }, "responses": { "200": { "description": "Report accepted", "content": { "application/json": { "schema": { "type": "object", "required": ["success", "message"], "properties": { "success": { "type": "boolean" }, "message": { "type": "string" } } } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/privacy-settings": {
      "get": { "tags": ["User Profiles"], "summary": "Get privacy settings", "responses": { "200": { "description": "Current privacy settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PrivacySettings" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/privacy": {
      "patch": { "tags": ["User Profiles"], "summary": "Update privacy settings", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PrivacySettings" } } } }, "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/message-filters": {
      "get": { "tags": ["User Profiles"], "summary": "Get inbound message filters", "responses": { "200": { "description": "Current message filters", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageFilters" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } },
      "put": { "tags": ["User Profiles"], "summary": "Replace inbound message filters", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageFilters" } } } }, "responses": { "204": { "description": "Filters persisted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/business": {
      "get": { "tags": ["User Profiles"], "summary": "Get business-profile fields", "responses": { "200": { "description": "Business profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BusinessProfile" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } },
      "patch": { "tags": ["User Profiles"], "summary": "Update business-profile fields", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BusinessProfile" } } } }, "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/dnd": {
      "patch": { "tags": ["User Profiles"], "summary": "Update Do Not Disturb settings", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "dnd_enabled": { "type": "boolean" }, "dnd_until": { "type": ["string", "null"], "format": "date-time" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/status-visibility": {
      "patch": { "tags": ["User Profiles"], "summary": "Update status visibility", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["status_visibility"], "properties": { "status_visibility": { "type": "string" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/users/me/contact-sharing": {
      "post": { "tags": ["User Profiles"], "summary": "Share configured contact details with another user", "description": "Returns only contact fields the service authorizes for this relationship. Callers cannot select arbitrary profile columns.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["target_user_id"], "properties": { "target_user_id": { "type": "string", "format": "uuid" } } } } } }, "responses": { "200": { "description": "Authorized contact fields", "content": { "application/json": { "schema": { "type": "object", "properties": { "phone_number": { "type": "string" }, "email": { "type": "string", "format": "email" } } } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    },
    "/users/me/notification-preferences": {
      "get": { "tags": ["User Profiles"], "summary": "Get notification preferences", "responses": { "200": { "description": "Notification preferences", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreferences" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } },
      "patch": { "tags": ["User Profiles"], "summary": "Update notification preferences", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreferences" } } } }, "responses": { "200": { "$ref": "#/components/responses/ProfileResponse" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Supabase-issued access token. Never place tokens in query strings or logs." }
    },
    "parameters": {
      "UserId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "StatusId": { "name": "statusId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "Limit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "Offset": { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }
    },
    "schemas": {
      "UserProfile": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "display_name": { "type": ["string", "null"] },
          "bio": { "type": ["string", "null"] },
          "avatar_url": { "type": ["string", "null"], "format": "uri" },
          "cover_photo_url": { "type": ["string", "null"], "format": "uri" },
          "native_language": { "type": ["string", "null"] },
          "target_languages": { "type": "array", "items": { "type": "string" } },
          "proficiency_level": { "type": ["string", "null"] },
          "study_streak_days": { "type": "integer", "minimum": 0 },
          "is_vip": { "type": "boolean" },
          "profile_visibility": { "type": "string", "enum": ["everyone", "vips_only", "hidden"] }
        },
        "additionalProperties": true
      },
      "UpdateProfileRequest": {
        "type": "object",
        "description": "Validated UpdateProfileDto. Unknown fields are rejected by the global ValidationPipe.",
        "additionalProperties": true
      },
      "ProfileVisitor": {
        "type": "object",
        "description": "Privacy-filtered visitor projection. Masked visitors must not expose identity fields.",
        "properties": { "is_blurred": { "type": "boolean" }, "visited_at": { "type": "string", "format": "date-time" }, "profile": { "$ref": "#/components/schemas/UserProfile" } },
        "additionalProperties": true
      },
      "ProfileSearchResult": { "type": "object", "required": ["id", "display_name", "avatar_url"], "properties": { "id": { "type": "string", "format": "uuid" }, "display_name": { "type": "string" }, "avatar_url": { "type": ["string", "null"], "format": "uri" } } },
      "Badge": { "type": "object", "required": ["id", "name", "description"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" } } },
      "PrivacySettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "privacy_hide_age": { "type": "boolean" },
          "privacy_hide_location": { "type": "boolean" },
          "privacy_hide_from_search": { "type": "boolean" },
          "privacy_hide_gender": { "type": "boolean" },
          "privacy_last_seen": { "type": "string" },
          "privacy_profile_photo": { "type": "string" },
          "privacy_about_info": { "type": "string" },
          "privacy_status": { "type": "string" },
          "incognito_visits": { "type": "boolean" },
          "profile_visibility": { "type": "string", "enum": ["everyone", "vips_only", "hidden"] }
        }
      },
      "MessageFilters": { "type": "object", "additionalProperties": false, "properties": { "age_min": { "type": "integer", "minimum": 18 }, "age_max": { "type": "integer", "minimum": 18 }, "allowed_native_languages": { "type": "array", "items": { "type": "string" } }, "allowed_genders": { "type": "array", "items": { "type": "string" } } } },
      "BusinessProfile": { "type": "object", "additionalProperties": false, "properties": { "business_name": { "type": "string" }, "business_hours": { "type": "string" }, "website_url": { "type": "string", "format": "uri" }, "catalog": { "type": "array", "items": { "type": "object", "additionalProperties": true } } } },
      "NotificationPreferences": { "type": "object", "additionalProperties": true, "properties": { "custom_tone_url": { "type": "string", "format": "uri" }, "vibration_pattern": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } },
      "MediaPresignRequest": { "type": "object", "required": ["filename", "contentType"], "additionalProperties": false, "properties": { "filename": { "type": "string" }, "contentType": { "type": "string" } } },
      "MediaPresignResult": { "type": "object", "required": ["uploadUrl", "mediaUrl", "objectKey"], "properties": { "uploadUrl": { "type": "string", "format": "uri" }, "mediaUrl": { "type": "string", "format": "uri" }, "objectKey": { "type": "string" } } },
      "ReportUserRequest": { "type": "object", "required": ["reported_id", "reason_category"], "additionalProperties": false, "properties": { "reported_id": { "type": "string", "format": "uuid" }, "reason_category": { "type": "string" }, "description": { "type": "string" }, "context_url": { "type": "string", "format": "uri" } } },
      "ProficiencyAssessmentRequest": { "type": "object", "required": ["score"], "additionalProperties": false, "properties": { "score": { "type": "number", "minimum": 0, "maximum": 100 } } },
      "ProficiencyAssessmentResponse": { "type": "object", "required": ["level"], "properties": { "level": { "type": "string" } } },
      "XpResponse": { "type": "object", "required": ["totalXp"], "properties": { "totalXp": { "type": "number", "minimum": 0 } } },
      "DeletionScheduled": { "type": "object", "required": ["message", "scheduled_for_deletion_at"], "properties": { "message": { "type": "string" }, "scheduled_for_deletion_at": { "type": "string", "format": "date-time" } } },
      "Error": { "type": "object", "properties": { "statusCode": { "type": "integer" }, "message": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }, "error": { "type": "string" } } }
    },
    "responses": {
      "ProfileResponse": { "description": "Profile projection allowed for the request context", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } } },
      "ProfilePageResponse": { "description": "Bounded social-graph page", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "total"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/UserProfile" } }, "total": { "type": "integer", "minimum": 0 } } } } } },
      "MediaPresignResponse": { "description": "Short-lived upload URL and server-owned object identity", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MediaPresignResult" } } } },
