{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elgl.dev/schemas/design-sync-manifest-v1.json",
  "title": "ELGL design-sync manifest v1",
  "description": "Repository-owned provenance contract linking Relay/Spartan implementation artefacts to deterministic previews and Claude Design paths.",
  "type": "object",
  "required": ["schemaVersion", "project", "policy", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "projectId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "policy": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "repoPathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "ownerLayer",
        "repositoryPaths",
        "previewPaths",
        "claudeDesignPath",
        "syncDirection",
        "lastReconciledCommit",
        "requiredStates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "kind": {
          "enum": ["foundation", "primitive", "helm", "screen", "modal", "flow"]
        },
        "ownerLayer": {
          "enum": ["relay", "spartan-helm", "spartan-brain", "feature"]
        },
        "repositoryPaths": { "$ref": "#/$defs/repoPathList" },
        "previewPaths": { "$ref": "#/$defs/repoPathList" },
        "claudeDesignPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "syncDirection": {
          "enum": ["code-first", "design-first", "reconcile"]
        },
        "lastReconciledCommit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "requiredStates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "implementationAudit": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
