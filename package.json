{
  "name": "hellotalk-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "HelloTalk Open-Core Platform (Angular v22 + NestJS + Supabase + Centrifugo + LiveKit)",
  "engines": {"node": ">=22.0.0", "npm": ">=10.0.0"},
  "packageManager": "npm@10.9.8",
  "scripts": {
    "check:constitution": "node scripts/verify-constitution.mjs",
    "check:agent-ui-governance": "node scripts/check-agent-ui-governance.mjs",
    "check:design-sync": "node scripts/verify-design-sync-manifest.mjs",
    "check:design-sync-drift": "node scripts/check-design-sync-drift.mjs",
    "check:spartan-boundaries": "node scripts/verify-spartan-boundaries.mjs",
    "check:component-system": "node scripts/verify-component-system-convergence.mjs",
    "check:legacy-primitive-delta": "node scripts/check-legacy-primitive-delta.mjs",
    "check:visual-contract-matrix": "node scripts/verify-visual-contract-matrix.mjs",
    "check:rtl-logical-contract": "node scripts/verify-rtl-logical-contract.mjs",
    "check:focus-ring-contract": "node scripts/verify-focus-ring-contract.mjs",
    "check:reduced-motion-contract": "node scripts/verify-reduced-motion-contract.mjs",
    "check:ux-platform-contract": "node scripts/verify-ux-platform-contract.mjs",
    "check:ux-100-percent": "node scripts/verify-ux-100-percent.mjs",
    "report:ui-design-coverage": "node scripts/report-ui-design-coverage.mjs",
    "report:ux-system-health": "node scripts/report-ux-system-health.mjs",
    "check:control-flow": "cd frontend && npm run check:control-flow",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:check": "npm run lint:check:frontend && npm run lint:check:backend",
    "lint:check:frontend": "cd frontend && npm run lint:check",
    "lint:check:backend": "cd backend && npm run lint:check",
    "lint:check:admin": "cd admin-portal && npm run lint:check",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "lint:admin": "cd admin-portal && npm run lint:check",
    "bootstrap:node": "bash install-node.sh",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npx ng build",
    "build:backend": "cd backend && npm run build",
    "build:admin": "cd admin-portal && npm run build",
    "start:admin": "cd admin-portal && npm start",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && npm run test",
    "test:admin": "cd admin-portal && npm run test",
    "verify": "npm run check:constitution && npm run check:agent-ui-governance && npm run check:design-sync && npm run check:spartan-boundaries && npm run check:component-system && npm run check:visual-contract-matrix && npm run check:rtl-logical-contract && npm run check:focus-ring-contract && npm run check:reduced-motion-contract && npm run check:ux-platform-contract && npm run lint:check && npm run build && npm test && node scripts/check-conflict-markers.mjs && cd backend && npm run verify",
    "verify:node": "node --version && npm --version && echo '✅ Node.js and npm verified'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "if [ -d .git ]; then npx husky || true; fi"
  },
  "dependencies": {"@ngx-translate/core": "^15.0.0", "@ngx-translate/http-loader": "^8.0.0", "xss": "^1.0.15"},
  "devDependencies": {"@eslint/js": "^10.0.1", "artillery": "^2.0.33", "husky": "^9.1.7", "lint-staged": "^15.2.10", "prettier": "^3.3.3"},
  "lint-staged": {"*.{js,ts,html,css,scss,json,md,mdx,yaml,yml}": ["prettier --write"]}
}
