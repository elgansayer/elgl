{
  "name": "hellotalk-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "HelloTalk Open-Core Platform (Angular v22 + NestJS + Supabase + Centrifugo + LiveKit)",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "check:constitution": "node scripts/verify-constitution.mjs",
    "check:lint-contract": "node --test scripts/verify-project-lint-contract.test.mjs && node scripts/verify-project-lint-contract.mjs",
    "check:agent-ui-governance": "node scripts/check-agent-ui-governance.mjs",
    "check:design-sync": "node scripts/verify-design-sync-manifest.mjs",
    "check:design-sync-drift": "node scripts/check-design-sync-drift.mjs",
    "check:spartan-boundaries": "node scripts/verify-spartan-boundaries.mjs",
    "check:spartan-full-tree": "node scripts/report-full-tree-spartan-adoption.mjs --strict",
    "check:component-system": "node scripts/verify-component-system-convergence.mjs",
    "check:legacy-primitive-delta": "node scripts/check-legacy-primitive-delta.mjs",
    "check:visual-contract-matrix": "node scripts/verify-visual-contract-matrix.mjs",
    "check:rtl-logical-contract": "node scripts/verify-rtl-logical-contract.mjs",
    "check:focus-ring-contract": "node scripts/verify-focus-ring-contract.mjs",
    "check:reduced-motion-contract": "node scripts/verify-reduced-motion-contract.mjs",
    "check:ux-platform-contract": "node scripts/verify-ux-platform-contract.mjs",
    "check:ux-100-percent": "node scripts/verify-ux-100-percent.mjs",
    "check:translation-safe-apis": "node --test scripts/verify-translation-safe-component-apis.test.mjs && node scripts/verify-translation-safe-component-apis.mjs",
    "check:screen-reader-naming": "node --test scripts/verify-screen-reader-naming.test.mjs && node scripts/verify-screen-reader-naming.mjs",
    "check:dependency-compatibility-lanes": "node --test scripts/dependency-compatibility-lanes.test.mjs",
    "check:empty-state-illustrations": "node --test scripts/verify-empty-state-illustrations.test.mjs && node scripts/verify-empty-state-illustrations.mjs",
    "check:no-aws-sdk": "node scripts/verify-no-aws-sdk.mjs",
    "report:spartan-full-tree": "node scripts/report-full-tree-spartan-adoption.mjs",
    "report:relay-primitive-usage": "node scripts/report-relay-primitive-usage.mjs",
    "report:ui-design-coverage": "node scripts/report-ui-design-coverage.mjs",
    "report:ux-system-health": "node scripts/report-ux-system-health.mjs",
    "report:claude-design-reconciliation": "node scripts/report-claude-design-reconciliation.mjs",
    "check:control-flow": "cd frontend && npm run check:control-flow",
    "lint": "npm run lint:frontend && npm run lint:backend && npm run lint:admin",
    "lint:check": "npm run lint:check:frontend && npm run lint:check:backend && npm run lint:check:admin",
    "lint:check:frontend": "cd frontend && npm run lint:check",
    "lint:check:backend": "cd backend && npm run lint:check",
    "lint:check:admin": "cd admin-portal && npm run lint:check",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "lint:admin": "cd admin-portal && npm run lint:check",
    "bootstrap:node": "bash install-node.sh",
    "build": "npm run build:frontend && npm run build:backend && npm run build:admin",
    "build:frontend": "cd frontend && npx ng build",
    "build:backend": "cd backend && npm run build",
    "build:admin": "cd admin-portal && npm run build",
    "start:admin": "cd admin-portal && npm start",
    "test": "npm run test:frontend && npm run test:backend && npm run test:admin && npm run test:r2-gateway",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && npm run test",
    "test:admin": "cd admin-portal && npm run test",
    "test:r2-gateway": "cd workers/r2-gateway && npm test",
    "verify": "npm run check:constitution && npm run check:lint-contract && npm run check:agent-ui-governance && npm run check:design-sync && npm run check:spartan-boundaries && npm run check:spartan-full-tree && npm run check:component-system && npm run check:visual-contract-matrix && npm run check:rtl-logical-contract && npm run check:focus-ring-contract && npm run check:reduced-motion-contract && npm run check:ux-platform-contract && npm run check:translation-safe-apis && npm run check:screen-reader-naming && npm run check:dependency-compatibility-lanes && npm run check:empty-state-illustrations && npm run check:no-aws-sdk && npm run lint:check && npm run build && npm test && node scripts/check-conflict-markers.mjs && cd backend && npm run verify",
    "verify:node": "node --version && npm --version && echo '✅ Node.js and npm verified'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "if [ -d .git ]; then npx husky || true; fi"
  },
  "dependencies": {
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "artillery": "^2.0.34",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,ts,html,css,scss,json,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  }
}