# Factory Dashboard environment variables
# Copy this to .env and fill in real values

# GitHub Personal Access Token (needs repo read + actions read scopes)
GH_TOKEN=ghp_your_token_here

# HTTP Basic Auth for every dashboard route except /health.
# The server refuses to start with a missing/short password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-at-least-16-random-characters
